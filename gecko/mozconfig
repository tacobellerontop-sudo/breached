# Breached's own Gecko build: the full engine compiled from source once per
# Gecko release, then reused by every Breached build (build-gecko.yml).
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-maintenance-service
ac_add_options --disable-default-browser-agent
# Build output on D: (the runner's bigger disk; C: filled up).
mk_add_options MOZ_OBJDIR=D:/obj-gecko
# The 16 GB GitHub runner runs out of memory linking Rust with full LTO.
ac_add_options --disable-release
mk_add_options MOZ_PARALLEL_BUILD=3
